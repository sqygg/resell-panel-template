# SellAuth Credentials (from https://dash.sellauth.com/api)
SELLAUTH_API_KEY=your_sellauth_api_key_here
SELLAUTH_SHOP_ID=your_shop_id_here

# Admin password for the web UI — CHANGE THIS FROM THE DEFAULT
ADMIN_PASSWORD=admin

# Session secret for cookie signing (auto-generated if empty, must stay fixed across restarts)
SESSION_SECRET=

# --- Branding (shows in the panel header + login page) ---
BRAND_NAME=DTF MARKET
BRAND_TAGLINE=Your reliable partner in gaming solutions.

# Public URL of the panel (used to build referral links). Example: https://panel.dtfmarket.com
PUBLIC_URL=

# Referrer earns this % of a referred reseller's order totals (default 5)
REFERRAL_COMMISSION_PERCENT=5

# Default discount % applied when you approve a reseller application (default 30)
DEFAULT_APPLICATION_DISCOUNT=30

# --- Security settings (optional) ---
# Production mode: disables debug, hides /docs, suppresses error details
ENVIRONMENT=production
DEBUG=false

# Rate limiting (recommended: leave enabled)
RATE_LIMIT_ENABLED=true

# Allowed CORS origins — comma-separated, empty = all origins allowed
# Example: ALLOWED_ORIGINS=https://your-domain.com,https://panel.your-domain.com
ALLOWED_ORIGINS=

# Max request body size in bytes (default: 64KB)
MAX_REQUEST_SIZE_BYTES=65536

# Host and port (default: 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000

# Discord bot (optional — leave empty to disable)
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
